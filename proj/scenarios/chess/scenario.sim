# Turn scenario with legal move generation and search in rules.lua
# Board state uses signed piece codes while these character entries style them
[scenario]
version=4
kernel=turn

[rules]
file=rules.lua

[world]
width=8
height=8
steps=600
seed=31
boundary=bounded

[output]
snapshot_stride=1
view=grid

[presentation]
title=Chess
subtitle=Orthodox self-play from the initial position
theme=chess
duration_seconds=90
format=demo
projection=flat
hud=true
labels=none
trails=0
vectors=false

# Poster and camera cues are presentation-only
[asset.poster_paper]
file=shared/Paper001_2K-Color.png
kind=image

[cue.poster]
frame=0
kind=poster
asset=poster_paper
text=Joszs chess pieces · CC BY 4.0

[cue.board]
frame=0
kind=camera
x=4
y=4
width=8
height=10.4
duration=0

# One Lua callback searches and commits each complete ply
[turn]
topology=grid
controller=script

# Type IDs follow the signed piece magnitudes used by rules.lua
[characters]
count=13

[character.referee]
count=1
shape=cell
colour=000000

[character.white_king]
count=1
shape=icon
glyph=wk
colour=fff8e1

[character.white_queen]
count=1
shape=icon
glyph=wq
colour=fff8e1

[character.white_rook]
count=1
shape=icon
glyph=wr
colour=fff8e1

[character.white_bishop]
count=1
shape=icon
glyph=wb
colour=fff8e1

[character.white_knight]
count=1
shape=icon
glyph=wn
colour=fff8e1

[character.white_pawn]
count=1
shape=icon
glyph=wp
colour=fff8e1

[character.black_king]
count=1
shape=icon
glyph=bk
colour=3e2723

[character.black_queen]
count=1
shape=icon
glyph=bq
colour=3e2723

[character.black_rook]
count=1
shape=icon
glyph=br
colour=3e2723

[character.black_bishop]
count=1
shape=icon
glyph=bb
colour=3e2723

[character.black_knight]
