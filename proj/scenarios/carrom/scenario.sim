# Timeline scenario driven by the shot and match controller in rules.lua
# Board coordinates use carrom-board units and one step is a physics interval
[scenario]
version=4
kernel=timeline

[world]
width=16
height=16
steps=10800
boundary=bounded

[output]
snapshot_stride=1
view=plane

[presentation]
title=Carrom
subtitle=20 discs and two shot policies
theme=carrom
duration_seconds=180
format=demo
projection=flat
hud=true
labels=none
trails=0
vectors=false

# Static art and piece sprites loaded by the carrom renderer
[asset.poster_paper]
file=shared/Paper001_2K-Color.png
kind=image

[asset.carrom_board]
file=assets/carrom-board.jpg
kind=image

[asset.kulhad_chai]
file=assets/kulhad-chai-top.png
kind=image

[asset.carrom_striker]
file=assets/striker-moon-teal-navy.png
kind=image

[asset.carrom_queen]
file=assets/queen.png
kind=image

[asset.carrom_white]
file=assets/white-coin.png
kind=image

[asset.carrom_black]
file=assets/black-coin.png
kind=image

[cue.poster]
frame=0
kind=poster
asset=poster_paper
text=Carrom · 1v1

# Lua selects shots, advances physics, applies scoring, and ends the match
[rules]
file=rules.lua

[cue.board]
frame=0
kind=camera
x=8
y=8
width=18
height=18
duration=0

[cue.board_art]
frame=0
kind=backdrop
asset=carrom_board
x=8
y=8
width=16
height=15.86497890295
layer=-2
parallax=1

[cue.chai]
frame=0
kind=sprite
asset=kulhad_chai
x=17.45
y=12.75
width=2.35
duration=10800
layer=2

[cue.chai_bubbles]
frame=0
kind=effect
text=chai swirls and bubbles
x=17.45
y=12.75
duration=10800
opacity=0.9
scale=1.55
layer=3
ambient=bubbles

[cue.chai_steam]
frame=0
kind=effect
text=chai steam
x=17.45
y=12.42
duration=10800
opacity=0.78
scale=1.55
layer=4
ambient=steam

# Entity zero carries score text; remaining IDs match the disc table in Lua
[characters]
count=21

[character.match_score]
count=1
x=8
y=.55
shape=text
glyph=CHASE
colour=382312
layer=10
size=.27

