# Timeline scenario with monthly country, flight, and ship updates in rules.lua
# Character ranges stay contiguous because Lua addresses them by fixed offsets
[scenario]
version=4
kernel=timeline

[world]
width=101
height=101
steps=88
boundary=bounded
seed=31

[output]
snapshot_stride=1
view=plane

[presentation]
title=Chronus
subtitle=177-country coupled SEIR model
theme=chronus
duration_seconds=264
format=demo
projection=flat
hud=true
labels=none
trails=0
vectors=false

[rules]
file=rules.lua

# Counts must match COUNTRY_COUNT, FLIGHT_COUNT, and SHIP_COUNT in rules.lua
[characters]
count=4

[character.country_state_a]
count=177
shape=circle
motion=grounded
colour=000000
size=1

[character.country_state_b]
count=177
shape=circle
motion=grounded
colour=000000
size=1

[character.flight_state]
count=1200
shape=circle
motion=grounded
colour=000000
size=1

[character.ship_state]
count=300
shape=circle
motion=water
colour=000000
size=1
