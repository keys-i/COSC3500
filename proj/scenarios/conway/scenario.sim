# Cellular scenario with three live factions and three trail states per faction
# rules.lua seeds the board while ai.lua supplies one transition per cell
[scenario]
version=4
kernel=cellular

[world]
width=200
height=140
steps=720
boundary=bounded
seed=31

[output]
snapshot_stride=1
view=grid

[presentation]
title=Conway
subtitle=Three-owner Life on a 200 x 140 grid
theme=conway
duration_seconds=60
format=demo
projection=flat
hud=true
labels=none
trails=0
vectors=false

# The background is presentation-only and never enters cellular state
[asset.war_background]
file=assets/conway-war.png
kind=image

[cue.poster]
frame=0
kind=poster
asset=war_background
text=Conway · three-owner Life

[cue.open]
frame=0
kind=camera
x=100
y=70
width=240
height=160
duration=0

[cue.war_background]
frame=0
kind=backdrop
asset=war_background
x=100
y=70
width=285
height=160
layer=-4
parallax=1

# State zero is empty; state IDs 1 through 12 follow the character order below
[cellular]
states=13

[rules]
file=rules.lua

# The first three entries are live cells and the remaining nine are trails
[characters]
count=12

[character.red_vanguard]
count=1
shape=cell
colour=ef4444

[character.blue_calculus]
count=1
shape=cell
colour=3b82f6

[character.yellow_cabal]
count=1
shape=cell
colour=facc15

[character.red_trail_1]
count=1
shape=cell
colour=f87171

[character.red_trail_2]
count=1
shape=cell
colour=fca5a5

[character.red_trail_3]
count=1
shape=cell
colour=fecaca

[character.blue_trail_1]
count=1
shape=cell
colour=60a5fa

[character.blue_trail_2]
count=1
shape=cell
colour=93c5fd

[character.blue_trail_3]
count=1
shape=cell
colour=bfdbfe

[character.yellow_trail_1]
count=1
shape=cell
colour=fde047

[character.yellow_trail_2]
count=1
shape=cell
colour=facc15

[character.yellow_trail_3]
count=1
shape=cell
colour=ca8a04
