# Cellular scenario with three ancestral factions and twelve live realm states
# rules.lua seeds scattered micro-kingdoms while kingdoms.lua evolves ancestry
[scenario]
version=4
kernel=cellular

[world]
width=200
height=140
steps=4320
boundary=bounded
seed=31

[output]
snapshot_stride=8
view=grid

[presentation]
title=Conway
subtitle=4,320 generations of kingdoms, inheritance, alliances, and collapse
theme=conway
duration_seconds=60
pacing=0:0,144:15,576:30,2160:45,4320:60
format=demo
projection=flat
hud=true
labels=none
trails=0
vectors=false

# The background is presentation-only and never enters cellular state
[asset.war_background]
file=assets/conway-war.png
kind=image

[cue.poster]
frame=0
kind=poster
asset=war_background
text=Conway · the micro-kingdoms

[cue.open]
frame=0
kind=camera
x=100
y=70
width=240
height=160
duration=0

[cue.war_background]
frame=0
kind=backdrop
asset=war_background
x=100
y=70
width=285
height=160
layer=-4
parallax=1

# State zero is free land; state IDs 1 through 12 are living ancestral mixes
[cellular]
states=13

[rules]
file=rules.lua

# Characters define the ordered state palette. There are no trails: collapse
# returns a cell to free land, ready for a later settlement.
[characters]
count=12

[character.red]
count=1
shape=cell
colour=ef4444

[character.blue]
count=1
shape=cell
colour=3b82f6

[character.yellow]
count=1
shape=cell
colour=facc15

[character.red_blue_red]
count=1
shape=cell
colour=b95a75

[character.red_blue_blue]
count=1
shape=cell
colour=697fc1

[character.red_yellow_red]
count=1
shape=cell
colour=e76940

[character.red_yellow_yellow]
count=1
shape=cell
colour=f4ab23

[character.blue_yellow_blue]
count=1
shape=cell
colour=709fb3

[character.blue_yellow_yellow]
count=1
shape=cell
colour=ccbd4a

[character.red_blue_equal]
count=1
shape=cell
colour=936d9b

[character.red_yellow_equal]
count=1
shape=cell
colour=ee8a30

[character.blue_yellow_equal]
count=1
shape=cell
colour=96af55
