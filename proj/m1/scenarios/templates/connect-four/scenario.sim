# Connect Four-like board replay driven by a bounded local Lua rule.
[scenario]
version=4
kernel=turn

[world]
width=7
height=6
steps=7
boundary=bounded

[output]
snapshot_stride=1
view=grid

[turn]
topology=grid
search=lua
budget=256

[rules]
file=rules.lua

[characters]
count=3

[character.referee]
count=1
shape=cell
colour=1e3a8a

[character.red]
count=1
shape=cell
colour=ef4444

[character.yellow]
count=1
shape=cell
colour=facc15
