# Weighted rules compile once; the continuous loop only sees compact records.
[scenario]
version=4
kernel=continuous

[world]
width=120
height=80
time_step=0.05
steps=300
seed=19
boundary=wrap

[behaviour.flock]
code=cohere
target=boid
weight=0.8

[behaviour.space]
code=separate
target=boid
weight=1.2

[behaviour.heading]
code=align
target=boid
weight=0.4

[behaviour.drift]
code=wander
weight=0.2

[characters]
count=1

[character.boid]
count=96
speed=1.5
behaviours=flock,space,heading,drift
colour=80cbc4
