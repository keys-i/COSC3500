[scenario]
version=4
kernel=timeline

[world]
width=120
height=80
steps=6
boundary=bounded

[output]
snapshot_stride=1
view=plane

[characters]
count=3

[character.truck]
count=1
x=10
y=60
shape=cell
colour=d32f2f

[character.crew]
count=1
x=15
y=60
shape=circle
colour=ffb300

[character.fire]
count=1
x=100
y=20
shape=circle
colour=ff5722

[event.drive]
step=1
action=move
character=truck
x=65
y=35

[event.deploy]
step=2
action=move
character=crew
x=75
y=30

[event.extinguish]
step=4
action=hide
character=fire

[cue.alert]
frame=1
kind=caption
text=Fire response
x=60
y=8
layer=2
