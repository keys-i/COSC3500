# A colour-and-number card game replay; rules are deliberately external.
[scenario]
version=4
kernel=turn

[world]
width=6
height=2
steps=6
boundary=bounded

[output]
snapshot_stride=1
view=grid

[turn]
topology=graph
search=dijkstra
budget=48
edges=0:1,1:2,2:3,3:4,4:5,6:7,7:8,8:9,9:10,10:11

[characters]
count=5

[character.dealer]
count=1
shape=cell
colour=374151

[character.red_three]
count=1
shape=text
glyph=3
colour=ef4444

[character.blue_five]
count=1
shape=text
glyph=5
colour=3b82f6

[character.yellow_two]
count=1
shape=text
glyph=2
colour=facc15

[character.green_skip]
count=1
shape=text
glyph=S
colour=22c55e

[action.red]
step=1
actor=dealer
verb=set
arg0=0
arg1=2

[action.blue]
step=2
actor=dealer
verb=set
arg0=1
arg1=3

[action.yellow]
step=3
actor=dealer
verb=set
arg0=2
arg1=4

[action.green]
step=4
actor=dealer
verb=set
arg0=3
arg1=5

[action.route]
step=5
actor=dealer
verb=search
arg0=0
arg1=5
