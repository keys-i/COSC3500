# A turn replay, not a rigid-body carrom solver.
[scenario]
version=4
kernel=turn

[world]
width=8
height=8
steps=5
boundary=bounded

[output]
snapshot_stride=1
view=grid

[turn]
topology=grid
search=none
budget=1

[characters]
count=4

[character.referee]
count=1
shape=cell
colour=111111

[character.white]
count=1
shape=cell
colour=f5f5f5

[character.black]
count=1
shape=cell
colour=212121

[character.queen]
count=1
shape=cell
colour=e53935

[action.place_white]
step=1
actor=referee
verb=set
arg0=27
arg1=2

[action.place_black]
step=2
actor=referee
verb=set
arg0=28
arg1=3

[action.place_queen]
step=3
actor=referee
verb=set
arg0=36
arg1=4
