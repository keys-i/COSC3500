# A ferry timetable sketch, not a hydrodynamic model.
[scenario]
version=4
kernel=timeline

[world]
width=140
height=70
steps=6
boundary=bounded

[output]
snapshot_stride=1
view=plane

[characters]
count=3

[character.ferry]
count=1
x=10
y=35
shape=cell
colour=1565c0

[character.wharf_a]
count=1
x=10
y=35
shape=cell
colour=6d4c41

[character.wharf_b]
count=1
x=130
y=35
shape=cell
colour=6d4c41

[event.depart]
step=1
action=move
character=ferry
x=45
y=35

[event.cross]
step=3
action=move
character=ferry
x=90
y=35

[event.arrive]
step=5
action=move
character=ferry
x=130
y=35

[cue.title]
frame=1
kind=caption
text=Harbour ferry
x=70
y=8
layer=2
