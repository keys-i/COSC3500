# Scripted backyard cricket presentation, not a physics or scoring model.
[scenario]
version=4
kernel=timeline

[world]
width=100
height=60
steps=6
boundary=bounded

[output]
snapshot_stride=1
view=plane

[characters]
count=3

[character.batter]
count=1
x=25
y=30
shape=circle
colour=1565c0

[character.bowler]
count=1
x=75
y=30
shape=circle
colour=c62828

[character.ball]
count=1
x=70
y=30
shape=circle
colour=ffffff

[event.bowl]
step=1
action=move
character=ball
x=50
y=30

[event.hit]
step=2
action=move
character=ball
x=30
y=18

[event.run]
step=3
action=move
character=batter
x=65
y=30

[cue.score]
frame=3
kind=caption
text=Four runs
x=50
y=8
layer=2
