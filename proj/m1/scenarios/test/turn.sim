# Board cells are set in file order and turns advance once per step.
[scenario]
version=4
kernel=turn

[world]
width=3
height=3
steps=2
boundary=bounded

[turn]
topology=grid
search=bfs
budget=8

[characters]
count=2

[character.referee]
count=1

[character.token]
count=1
shape=cell
colour=00aa00

[action.place]
step=1
actor=referee
verb=set
arg0=4
arg1=2
