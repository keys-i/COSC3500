# One change per frame checks event order
[scenario]
version=4
kernel=timeline

[world]
width=10
height=10
steps=3
boundary=bounded

[characters]
count=1

[character.actor]
count=1
x=1
y=1

[event.move]
step=1
action=move
character=actor
x=4
y=5

[event.hide]
step=2
action=hide
character=actor

[event.show]
step=3
action=show
character=actor
