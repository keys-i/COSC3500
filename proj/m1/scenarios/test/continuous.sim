# Small fixed continuous case for parser and kernel tests.
[scenario]
version=4
kernel=continuous

[world]
width=20
height=20
time_step=0.5
steps=4
seed=3
boundary=wrap

[characters]
count=2

[character.prey]
count=1
x=2
y=10
speed=1
sensing_radius=8
behaviours=flee
target=hunter

[character.hunter]
count=1
x=5
y=10
speed=1
sensing_radius=8
capture_radius=1
behaviours=seek,consume
target=prey
