{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "HPC_WARNINGS_AS_ERRORS": true,
        "M1_OPT_LEVEL": "7"
      }
    },
    {
      "name": "optimised",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    { "name": "dev", "inherits": "base" },
    { "name": "release", "inherits": "optimised" },
    {
      "name": "evidence",
      "inherits": "optimised",
      "cacheVariables": { "HPC_FIXED_RELEASE_FLAGS": true }
    },
    {
      "name": "cluster",
      "inherits": "optimised",
      "cacheVariables": { "HPC_REQUIRE_SLURM_ALLOCATION": true }
    },
    {
      "name": "asan",
      "inherits": "base",
      "cacheVariables": { "HPC_SANITIZER": "address,undefined" }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "HPC_COVERAGE": true
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "evidence", "configurePreset": "evidence" },
    { "name": "cluster", "configurePreset": "cluster" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "coverage", "configurePreset": "coverage" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "dev", "inherits": "base", "configurePreset": "dev" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    { "name": "cluster", "inherits": "base", "configurePreset": "cluster" },
    { "name": "asan", "inherits": "base", "configurePreset": "asan" },
    { "name": "coverage", "inherits": "base", "configurePreset": "coverage" }
  ]
}
