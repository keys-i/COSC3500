# Compact predator--prey run for the M2 presentation opening
[scenario]
version=4
kernel=continuous

[world]
width=960
height=540
time_step=1
steps=120
seed=31
boundary=wrap

[output]
snapshot_stride=1
view=plane

[presentation]
title=Predator--Prey
subtitle=Blue prey flee; red hunters seek
theme=neutral
duration_seconds=10
format=demo
projection=flat
hud=true
labels=none
trails=24
vectors=false

[characters]
count=2

[character.prey]
count=192
speed=3.2
sensing_radius=72
behaviours=flee
target=hunter
colour=4fc3f7
size=2.5

[character.hunter]
count=64
speed=4.0
sensing_radius=100
behaviours=seek
target=prey
colour=ef5350
size=2.5
