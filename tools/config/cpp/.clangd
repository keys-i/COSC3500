Diagnostics:
  UnusedIncludes: None

---
If:
  PathMatch: (assign|third_party)/.*
Index:
  Background: Skip
Diagnostics:
  Suppress: '*'

---
If:
  PathMatch: assign/.*\.cu(h)?
CompileFlags:
  Add: [-nocudainc, -nocudalib]

---
If:
  PathMatch: proj/m1/simulation/grid\.hpp
CompileFlags:
  Add:
    - -Wno-unused-function
    - -Wno-unneeded-internal-declaration
