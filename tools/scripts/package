#!/usr/bin/env bash
# Stage, verify, and archive one milestone without importing the other
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
milestone=${1:-m2}
case $milestone in m1|m2) ;; *)
    echo 'usage: tools/scripts/package [m1|m2]' >&2
    exit 2
    ;;
esac

stage="$root/build/package-$milestone"
model="$stage/model"
verify="$stage/verify"
archive="$stage/$milestone.zip"
for path in "$root/build" "$stage"; do
    [[ ! -L $path ]] || { echo "refusing symlink: $path" >&2; exit 2; }
done
cmake -E remove_directory "$stage"
cmake -E make_directory "$model"

common_paths=(docs proj/scenarios proj/assets tests tools/config tools/scripts)
if [[ $milestone == m1 ]]; then
    source_paths=(proj/m0 proj/m1 benches "${common_paths[@]}")
    targets=(m0 m1 simulation hpc_bench benchmark)
    verify_options=(-DBUILD_TESTING=ON -DHPC_BUILD_M2=OFF)
else
    # hpc_bench always compiles its M1 case catalogue, but it never links m1
    source_paths=(proj/m2 benches "${common_paths[@]}")
    targets=(m2 hpc_bench m2_simulation benchmark)
    verify_options=(-DBUILD_TESTING=ON -DHPC_BUILD_M0=OFF -DHPC_BUILD_M1=OFF)
fi

for path in "${source_paths[@]}"; do
    [[ -e $root/$path && ! -L $root/$path ]] || {
        echo "missing or linked: $path" >&2
        exit 2
    }
    find "$root/$path" -type l -print -quit | grep -q . && {
        echo "linked input: $path" >&2
        exit 2
    }
    cmake -E copy_directory "$root/$path" "$model/$path"
done
for path in CMakeLists.txt CMakePresets.json LICENSE Makefile README.md pyproject.toml uv.lock; do
    [[ -f $root/$path && ! -L $root/$path ]] || {
        echo "missing or linked: $path" >&2
        exit 2
    }
    cmake -E copy "$root/$path" "$model/$path"
done

if [[ $milestone == m2 ]]; then
    # Include only current M2 evidence, including its pre-candidate kernel snapshot
    evidence_paths=(
        results/profile/run-20260924T110021Z-rG8ANs
        results/profile/phase-615532
        results/profile/size-scaling-20260924T121852Z-foIDpY
    )
    for path in "${evidence_paths[@]}"; do
        [[ -d $root/$path && ! -L $root/$path ]] || {
            echo "missing or linked evidence: $path" >&2
            exit 2
        }
        find "$root/$path" -type l -print -quit | grep -q . && {
            echo "linked evidence: $path" >&2
            exit 2
        }
        cmake -E copy_directory "$root/$path" "$model/$path"
    done
fi

[[ ! -L $root/third_party/clx ]] || { echo 'linked input: third_party/clx' >&2; exit 2; }
find "$root/third_party/clx/include" "$root/third_party/clx/src" -type l -print -quit | grep -q . && {
    echo 'linked input: third_party/clx' >&2
    exit 2
}
cmake -E make_directory "$model/third_party/clx"
for path in CMakeLists.txt LICENSE; do cmake -E copy "$root/third_party/clx/$path" "$model/third_party/clx/$path"; done
for path in include src; do cmake -E copy_directory "$root/third_party/clx/$path" "$model/third_party/clx/$path"; done
find "$model" -type d -name __pycache__ -prune -exec cmake -E rm -rf -- {} +

cmake -S "$model" -B "$verify" -G Ninja -DCMAKE_BUILD_TYPE=Release "${verify_options[@]}"
cmake --build "$verify" --target "${targets[@]}"
if [[ $milestone == m1 ]]; then
    for bundle in chess chronus carrom heston conway; do
        cmake -E chdir "$model" "$verify/bin/m1" "templates/$bundle"
    done
    ctest --test-dir "$verify" --output-on-failure -R '^(m0\.smoke|m1\.simulation|hpc\.benchmark)$'
else
    cmake -E chdir "$model" "$verify/bin/m2" templates/chess --seed 31
    cmake -E chdir "$model" "$verify/bin/m2" test/pde-heat --seed 31
    cmake -E chdir "$model" "$verify/bin/m2" --benchmark templates/conway/100k --seed 31
    ctest --test-dir "$verify" --output-on-failure -R '^(m2\.simulation|hpc\.benchmark)$'
fi
(cd "$model" && cmake -E tar cf "$archive" --format=zip .)
cmake -E remove_directory "$verify"
printf 'package: %s\n' "${archive#"$root"/}"
