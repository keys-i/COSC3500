#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=tools/scripts/tools/lib.sh
. "$SCRIPT_DIR/lib.sh"

tool_config_validate

action=${1:-llvm}
if (($# > 0)); then
    shift
fi
preset=
while (($# > 0)); do
    case $1 in
        --preset)
            (($# >= 2)) || die "--preset requires a value"
            preset=$2
            shift 2
            ;;
        *) die "unknown coverage option: $1" ;;
    esac
done
validate_choice "$action" llvm,gcov,clean,report "coverage action"
output_root="$HPC_ROOT/$(tool_config_get coverage output_dir)"

reset_output() {
    local directory=$1
    case $directory in
        "$HPC_ROOT/results"/*) ;;
        *) die "coverage output is outside results/: $directory" ;;
    esac
    local relative=${directory#"$HPC_ROOT/"}
    case "/$relative/" in
        */../* | */./* | *//*) die "unsafe coverage output path: $directory" ;;
    esac
    local current="$HPC_ROOT/results"
    test ! -L "$current" || die "results/ may not be a symlink"
    local component
    local IFS=/
    for component in ${directory#"$HPC_ROOT/results/"}; do
        current="$current/$component"
        test ! -L "$current" ||
            die "coverage output path contains a symlink: $current"
    done
    run cmake -E remove_directory "$directory"
}

case $action in
    clean)
        reset_output "$output_root"
        exit 0
        ;;
    report)
        test -d "$output_root" || {
            skip "no coverage reports"
            exit 0
        }
        run find "$output_root" -type f -print
        exit 0
        ;;
esac

if test "$action" = llvm; then
    preset=${preset:-coverage-clang}
    local_profdata=
    local_cov=
    if ! local_profdata=$(find_llvm_tool llvm-profdata); then
        skip "LLVM coverage: llvm-profdata unavailable"
        exit 0
    fi
    if ! local_cov=$(find_llvm_tool llvm-cov); then
        skip "LLVM coverage: llvm-cov unavailable"
        exit 0
    fi
    configure_preset "$preset" --fresh
    build_preset "$preset" --target m0 hpc_bench --clean-first
    compiler_id=$(compiler_field "$preset" CMAKE_CXX_COMPILER_ID)
    [[ $compiler_id == *Clang* ]] ||
        die "LLVM coverage preset selected $compiler_id"
    output="$output_root/$preset/llvm"
    reset_output "$output"
    run mkdir -p "$output/raw" "$output/html"
    run env LLVM_PROFILE_FILE="$output/raw/%p-%m.profraw" \
        ctest --test-dir "$(build_dir "$preset")" --output-on-failure
    profiles=()
    while IFS= read -r file; do
        profiles+=("$file")
    done < <(find "$output/raw" -name '*.profraw' -type f -print)
    ((${#profiles[@]} > 0)) || die "tests produced no LLVM raw profiles"
    run "$local_profdata" merge -sparse "${profiles[@]}" \
        -o "$output/coverage.profdata"
    m0="$(target_binary "$preset" m0)"
    helper="$(build_dir "$preset")/bench/hpc_bench"
    exclude=$(tool_config_get coverage exclude_regex)
    print_command "$local_cov" report "$m0" -object "$helper" \
        -instr-profile "$output/coverage.profdata" \
        -ignore-filename-regex "$exclude"
    "$local_cov" report "$m0" -object "$helper" \
        -instr-profile "$output/coverage.profdata" \
        -ignore-filename-regex "$exclude" \
        >"$output/report.txt"
    run "$local_cov" show "$m0" -object "$helper" \
        -instr-profile "$output/coverage.profdata" \
        -ignore-filename-regex "$exclude" \
        -format=html -output-dir="$output/html"
    pass "LLVM coverage: ${output#"$HPC_ROOT"/}"
    exit 0
fi

preset=${preset:-coverage-gcc}
gxx=${CXX:-g++}
if ! command -v "$gxx" >/dev/null 2>&1 ||
    ! "$gxx" --version 2>&1 | grep -Eq 'GCC|gcc'; then
    skip "gcov coverage: GNU GCC unavailable"
    exit 0
fi
gcov_tool=${GCOV:-}
if test -z "$gcov_tool"; then
    case $gxx in
        *-*) gcov_tool="gcov-${gxx##*-}" ;;
        *) gcov_tool=gcov ;;
    esac
fi
if ! command -v "$gcov_tool" >/dev/null 2>&1; then
    skip "gcov unavailable"
    exit 0
fi
configure_preset "$preset" --fresh
build_preset "$preset" --target m0 hpc_bench --clean-first
run ctest --test-dir "$(build_dir "$preset")" --output-on-failure
output="$output_root/$preset/gcov"
reset_output "$output"
run mkdir -p "$output"
gcda_files=()
while IFS= read -r file; do
    gcda_files+=("$file")
done < <(find "$(build_dir "$preset")" -name '*.gcda' -type f -print)
((${#gcda_files[@]} > 0)) || die "tests produced no gcov data"
(
    cd "$output"
    run "$gcov_tool" -b -c "${gcda_files[@]}"
)
pass "gcov coverage: ${output#"$HPC_ROOT"/}"
