#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=tools/scripts/tools/lib.sh
. "$SCRIPT_DIR/lib.sh"

tool_config_validate
clang_config_validate

action=all
preset=mac-check
if (($# > 0)) && [[ $1 != --* ]]; then
    action=$1
    shift
fi
while (($# > 0)); do
    case $1 in
        --preset)
            (($# >= 2)) || die "--preset requires a value"
            preset=$2
            shift 2
            ;;
        *) die "unknown check option: $1" ;;
    esac
done
validate_choice "$action" lint,analyze,test,all "check action"
require_preset "$preset"

source_files=()
while IFS= read -r file; do
    source_files+=("$file")
done < <(list_source_files)

shell_files=()
while IFS= read -r file; do
    shell_files+=("$file")
done < <(list_shell_files)

run_lint() {
    ensure_configured "$preset"
    local tidy
    if tidy=$(find_llvm_tool clang-tidy); then
        local tidy_sources=()
        local file
        for file in "${source_files[@]}"; do
            case $file in
                *.cc | *.cpp | *.cxx) tidy_sources+=("$file") ;;
            esac
        done
        if ((${#tidy_sources[@]} > 0)); then
            local warnings_as_errors=
            local tidy_checks
            tidy_checks=$(clang_config_get tidy checks)
            tidy_checks+=",$(clang_config_get tidy parallel_checks)"
            if test "$(clang_config_get tidy warnings_as_errors)" = true; then
                warnings_as_errors='*'
            fi
            run "$tidy" --checks="$tidy_checks" \
                --warnings-as-errors="$warnings_as_errors" \
                --header-filter="$(clang_config_get tidy header_filter)" \
                -p "$(build_dir "$preset")" "${tidy_sources[@]}"
            pass "clang-tidy"
        fi
    else
        skip "clang-tidy unavailable"
    fi

    local cppcheck_tool
    if cppcheck_tool=$(find_tool CPPCHECK cppcheck); then
        run "$cppcheck_tool" --enable=warning,performance,portability \
            --error-exitcode=1 --std=c++20 --quiet "${source_files[@]}"
        pass "cppcheck"
    else
        skip "cppcheck unavailable"
    fi

    local shellcheck_tool
    if shellcheck_tool=$(find_tool SHELLCHECK shellcheck); then
        if ((${#shell_files[@]} > 0)); then
            run "$shellcheck_tool" -x -P "$HPC_ROOT" "${shell_files[@]}"
            pass "ShellCheck"
        fi
    else
        skip "ShellCheck unavailable"
    fi

    local shfmt_tool
    if shfmt_tool=$(find_tool SHFMT shfmt); then
        if ((${#shell_files[@]} > 0)); then
            run "$shfmt_tool" -d -i 4 -ci "${shell_files[@]}"
            pass "shfmt"
        fi
    else
        skip "shfmt unavailable"
    fi

    local actionlint_tool
    if actionlint_tool=$(find_tool ACTIONLINT actionlint); then
        local workflow_dir
        workflow_dir="$HPC_ROOT/$(tool_config_get actionlint workflow_dir)"
        run "$actionlint_tool" "$workflow_dir"/*.yml
        pass "actionlint"
    else
        skip "actionlint unavailable"
    fi
}

run_analyze() {
    local scan_build
    if scan_build=$(
        find_tool SCAN_BUILD scan-build scan-build-21 scan-build-18
    ); then
        local analysis_dir="$HPC_BUILD_ROOT/scan-build"
        run "$scan_build" --status-bugs cmake --fresh \
            -S "$HPC_ROOT" -B "$analysis_dir" -G Ninja \
            -DBUILD_TESTING=OFF -DHPC_MODE=check \
            -DHPC_WARNINGS_AS_ERRORS=OFF
        run "$scan_build" --status-bugs cmake --build "$analysis_dir" \
            --target m0 hpc_bench
        pass "Clang Static Analyzer"
    else
        skip "scan-build unavailable"
    fi

    local gxx
    if gxx=$(find_tool GXX g++-14 g++); then
        if "$gxx" --version 2>&1 | grep -Eq 'GCC|gcc'; then
            local analyzer_sources=()
            local file
            for file in "${source_files[@]}"; do
                case $file in
                    *.cc | *.cpp | *.cxx) analyzer_sources+=("$file") ;;
                esac
            done
            run "$gxx" -std=c++20 -Wall -Wextra -Wpedantic \
                -fanalyzer -fsyntax-only "${analyzer_sources[@]}"
            pass "GCC -fanalyzer"
        else
            skip "GCC -fanalyzer unavailable: $gxx is not GNU GCC"
        fi
    else
        skip "GCC -fanalyzer unavailable"
    fi
}

run_tests() {
    ensure_configured "$preset"
    build_preset "$preset" --target m0 hpc_bench
    local labels
    labels=$(tool_config_get check test_labels)
    labels=${labels//,/|}
    run ctest --test-dir "$(build_dir "$preset")" \
        --output-on-failure -L "$labels"
    pass "CTest"
}

case $action in
    lint) run_lint ;;
    analyze) run_analyze ;;
    test) run_tests ;;
    all)
        run "$SCRIPT_DIR/fmt"
        run_lint
        run_analyze
        run_tests
        ;;
esac
