#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=tools/scripts/tools/lib.sh
. "$SCRIPT_DIR/lib.sh"

tool_config_validate

(($# > 0)) || die "profile requires an explicit tool"
tool=$1
shift
preset=profile
target=m0
app_args=()
while (($# > 0)); do
    case $1 in
        --preset)
            (($# >= 2)) || die "--preset requires a value"
            preset=$2
            shift 2
            ;;
        --target)
            (($# >= 2)) || die "--target requires a value"
            target=$2
            shift 2
            ;;
        --)
            shift
            app_args=("$@")
            break
            ;;
        *) die "unknown profile option: $1" ;;
    esac
done
if ((${#app_args[@]} == 0)) && test -n "${HPC_MAKE_ARGS:-}"; then
    read -r -a app_args <<<"$HPC_MAKE_ARGS"
fi
profile_tools=perf-stat,perf-record,perf-c2c,memcheck,helgrind,drd
profile_tools+=,callgrind,cachegrind,massif,likwid,papi,hpctoolkit
profile_tools+=,scorep,scalasca,nsys,ncu
validate_choice "$tool" "$profile_tools" "profiling tool"
require_target "$target"
require_preset "$preset"

case $tool in
    papi)
        skip "PAPI: no instrumented benchmark region exists"
        exit 0
        ;;
    scorep)
        skip "Score-P: no small build exists for a real parallel target"
        exit 0
        ;;
    scalasca)
        skip "Scalasca: no Score-P trace from a real MPI/OpenMP target exists"
        exit 0
        ;;
    nsys | ncu)
        if ! find "$HPC_ROOT/proj" "$HPC_ROOT/assign" \
            -name '*.cu' -type f -print -quit \
            2>/dev/null | grep -q .; then
            skip "$tool: no CUDA implementation exists"
        else
            skip "$tool: no allocated GPU profiling driver exists"
        fi
        exit 0
        ;;
    perf-*)
        if test "$(uname -s)" != Linux; then
            skip "$tool unsupported platform: Linux perf only"
            exit 0
        fi
        if ! command -v perf >/dev/null 2>&1; then
            skip "$tool unavailable: perf not installed"
            exit 0
        fi
        ;;
    memcheck | helgrind | drd | callgrind | cachegrind | massif)
        if ! command -v valgrind >/dev/null 2>&1; then
            skip "$tool unavailable: Valgrind not installed"
            exit 0
        fi
        ;;
    likwid)
        if ! command -v likwid-perfctr >/dev/null 2>&1; then
            skip "LIKWID unavailable"
            exit 0
        fi
        if test "$target" = m0; then
            skip "LIKWID: m0 has no computational region to measure"
            exit 0
        fi
        ;;
    hpctoolkit)
        if ! command -v hpcrun >/dev/null 2>&1 ||
            ! command -v hpcstruct >/dev/null 2>&1 ||
            ! command -v hpcprof >/dev/null 2>&1; then
            skip "HPCToolkit unavailable"
            exit 0
        fi
        ;;
esac

ensure_built "$preset" "$target"
binary=$(target_binary "$preset" "$target")
profile_root="$HPC_ROOT/$(tool_config_get profile output_dir)"
output="$profile_root/$(date -u +%Y%m%dT%H%M%SZ)-$target-$tool"

ensure_output() {
    test -d "$output" || run mkdir -p "$output"
}

case $tool in
    perf-record | perf-c2c | memcheck | helgrind | drd | callgrind | \
        cachegrind | massif | hpctoolkit)
        ensure_output
        ;;
esac

case $tool in
    perf-stat)
        events=$(tool_config_get profile perf_events)
        events+=",$(tool_config_get profile perf_memory_events)"
        events+=",$(tool_config_get profile perf_system_events)"
        run perf stat -e "$events" -- "$binary" "${app_args[@]}"
        ;;
    perf-record)
        frequency=$(tool_config_get profile perf_frequency)
        validate_positive_integer "$frequency" perf_frequency
        run perf record -F "$frequency" -g -o "$output/perf.data" -- \
            "$binary" "${app_args[@]}"
        print_command perf report --stdio -i "$output/perf.data"
        perf report --stdio -i "$output/perf.data" >"$output/report.txt"
        ;;
    perf-c2c)
        run perf c2c record -o "$output/perf-c2c.data" -- \
            "$binary" "${app_args[@]}"
        print_command perf c2c report --stdio -i "$output/perf-c2c.data"
        perf c2c report --stdio -i "$output/perf-c2c.data" >"$output/report.txt"
        ;;
    memcheck | helgrind | drd)
        options=(
            --tool="$tool"
            --error-exitcode=99
            --log-file="$output/$tool.txt"
        )
        if test "$tool" = memcheck; then
            options+=(
                --leak-check=full
                --show-leak-kinds=all
                --track-origins=yes
            )
        fi
        run valgrind "${options[@]}" "$binary" "${app_args[@]}"
        ;;
    callgrind)
        collect_jumps=$(tool_config_get profile callgrind_collect_jumps)
        validate_choice "$collect_jumps" true,false callgrind_collect_jumps
        run valgrind --tool=callgrind --collect-jumps="$collect_jumps" \
            --callgrind-out-file="$output/callgrind.out" \
            "$binary" "${app_args[@]}"
        if command -v callgrind_annotate >/dev/null 2>&1; then
            print_command callgrind_annotate "$output/callgrind.out"
            callgrind_annotate "$output/callgrind.out" >"$output/callgrind.txt"
        else
            skip "callgrind_annotate unavailable; raw profile retained"
        fi
        ;;
    cachegrind)
        run valgrind --tool=cachegrind \
            --cachegrind-out-file="$output/cachegrind.out" \
            "$binary" "${app_args[@]}"
        ;;
    massif)
        run valgrind --tool=massif --massif-out-file="$output/massif.out" \
            "$binary" "${app_args[@]}"
        ;;
    likwid)
        run likwid-perfctr -C 0 -g FLOPS_DP -m "$binary" "${app_args[@]}"
        ;;
    hpctoolkit)
        run hpcrun -o "$output/measurements" "$binary" "${app_args[@]}"
        run hpcstruct -o "$output/structure.hpcstruct" "$binary"
        run hpcprof -S "$output/structure.hpcstruct" -o "$output/database" \
            "$output/measurements"
        ;;
esac

if test -d "$output"; then
    pass "$tool profile: ${output#"$HPC_ROOT"/}"
fi
