#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=tools/scripts/tools/lib.sh
. "$SCRIPT_DIR/lib.sh"

package_a1() {
    local source_dir="$HPC_ROOT/assign/1"
    local required_files=(
        matrixMultiply.cpp
        matrixMultiplyGPU.cu
        matrixMultiplyMPI.cpp
        slurm.zip
    )
    local name path
    for name in "${required_files[@]}"; do
        path="$source_dir/$name"
        test -f "$path" ||
            die "missing assignment file: ${path#"$HPC_ROOT"/}"
        test ! -L "$path" ||
            die "submission file may not be a symlink: $name"
    done

    local implementation_files=(
        "$source_dir/matrixMultiply.cpp"
        "$source_dir/matrixMultiplyGPU.cu"
        "$source_dir/matrixMultiplyMPI.cpp"
    )
    command -v rg >/dev/null 2>&1 || die "packaging a1 needs rg"

    local output_pattern='(std::(cout|cerr|clog)|(^|[^A-Za-z])'
    output_pattern+='(printf|fprintf|puts|fwrite)[[:space:]]*\('
    output_pattern+='|ofstream|fstream)'
    if rg -n "$output_pattern" "${implementation_files[@]}"; then
        die "assignment code writes output; remove it before packaging"
    fi
    if rg -n 'MPI_(Init|Init_thread|Finalize)[[:space:]]*\(' \
        "$source_dir/matrixMultiplyMPI.cpp"; then
        die "MPI_Init and MPI_Finalize belong in the supplied harness"
    fi
    if rg -ni '(mavx2|mavx512|__m256|__m512|avx2|avx512|immintrin)' \
        "${implementation_files[@]}"; then
        die "assignment code uses AVX2 or AVX-512, which isn't allowed"
    fi
    if rg -ni '(mkl|cblas|cublas|thrust|eigen)' \
        "${implementation_files[@]}"; then
        die "assignment code calls an outside maths library"
    fi

    local header include_pattern
    include_pattern='s/^[[:space:]]*#[[:space:]]*include[[:space:]]*"'
    include_pattern+='\([^"]*\)".*/\1/p'
    while IFS= read -r header; do
        case ${header##*/} in
            matrixMultiply.h | matrixMultiplyGPU.h | matrixMultiplyMPI.h) ;;
            *) die "assignment files can't include this header: $header" ;;
        esac
    done < <(
        sed -n "$include_pattern" "${implementation_files[@]}"
    )

    local stage="$HPC_BUILD_ROOT/submission/a1"
    test ! -L "$HPC_BUILD_ROOT" || die "build/ can't be a symlink"
    test ! -L "$HPC_BUILD_ROOT/submission" ||
        die "build/submission can't be a symlink"
    if test -e "$stage"; then
        test ! -L "$stage" || die "package path can't be a symlink"
        run cmake -E remove_directory "$stage"
    fi
    run mkdir -p "$stage"
    for name in "${required_files[@]}"; do
        run cp "$source_dir/$name" "$stage/$name"
    done
    local count
    count=$(find "$stage" -type f | wc -l | tr -d ' ')
    test "$count" = 4 || die "a1 package should contain exactly four files"
    pass "a1 package ready: ${stage#"$HPC_ROOT"/}"
}

copy_model_item() {
    local source=$1
    local destination=$2
    test -e "$source" || die "missing model input: ${source#"$HPC_ROOT"/}"
    test ! -L "$source" || die "model input can't be a symlink: $source"
    if test -d "$source" &&
        find "$source" -type l -print -quit | grep -q .; then
        die "model input contains a symlink: ${source#"$HPC_ROOT"/}"
    fi
    run mkdir -p "${destination%/*}"
    if test -d "$source"; then
        run cmake -E copy_directory "$source" "$destination"
    else
        run cmake -E copy "$source" "$destination"
    fi
}

package_m1() {
    local stage="$HPC_BUILD_ROOT/submission/m1"
    local source="$stage/model"
    local archive="$stage/m1.zip"
    local verify_build="$stage/verify-build"
    case $stage in
        "$HPC_BUILD_ROOT"/submission/m1) ;;
        *) die "unsafe m1 package path: $stage" ;;
    esac
    test ! -L "$HPC_BUILD_ROOT" || die "build/ can't be a symlink"
    test ! -L "$HPC_BUILD_ROOT/submission" ||
        die "build/submission can't be a symlink"
    if test -e "$stage"; then
        test ! -L "$stage" || die "package path can't be a symlink"
        run cmake -E remove_directory "$stage"
    fi
    run mkdir -p "$source"

    run cmake -S "$HPC_ROOT" -B "$verify_build" -G Ninja \
        -DHPC_MODE=check -DHPC_WARNINGS_AS_ERRORS=ON
    run cmake --build "$verify_build" --target m1
    run ctest --test-dir "$verify_build" --output-on-failure -R '^m1\.'

    local items=(
        config.cpp
        main.cpp
        model.hpp
        script.cpp
        script.hpp
        search.cpp
        search.hpp
        simulation.cpp
    )
    local item
    for item in "${items[@]}"; do
        copy_model_item \
            "$HPC_ROOT/proj/m1/$item" "$source/proj/m1/$item"
    done
    copy_model_item "$HPC_ROOT/proj/m1/scenarios/templates" \
        "$source/proj/m1/scenarios/templates"

    local file relative
    local scenario_member='^proj/m1/scenarios/templates/'
    scenario_member+='([^/]+\.sim|[^/]+/(scenario\.sim|[^/]+\.lua|assets/.+))$'
    while IFS= read -r file; do
        relative=${file#"$source"/}
        case $relative in
            proj/m1/config.cpp | \
                proj/m1/main.cpp | proj/m1/model.hpp | \
                proj/m1/script.cpp | proj/m1/script.hpp | \
                proj/m1/search.cpp | proj/m1/search.hpp | \
                proj/m1/simulation.cpp) ;;
            *)
                if [[ $relative =~ $scenario_member ]]; then
                    continue
                fi
                die "unexpected m1 package member: $relative"
                ;;
        esac
    done < <(find "$source" -type f -print)
    if find "$source" -type d \
        \( -name build -o -name results -o -name __pycache__ \
        -o -name .venv -o -name .git \) -print -quit | grep -q .; then
        die "m1 model contains a generated directory"
    fi
    print_command cmake -E tar cf "$archive" --format=zip .
    (
        cd "$source"
        cmake -E tar cf "$archive" --format=zip .
    )
    run cmake -E remove_directory "$source" "$verify_build"
    pass "m1 model ready: ${archive#"$HPC_ROOT"/}"
}

case ${1:-a1} in
    a1)
        (($# == 1)) || die "usage: package a1"
        package_a1
        ;;
    m1)
        (($# == 1)) || die "usage: package m1"
        package_m1
        ;;
    *) die "usage: package a1|m1" ;;
esac
