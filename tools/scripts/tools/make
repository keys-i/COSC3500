#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=tools/scripts/tools/lib.sh
. "$SCRIPT_DIR/lib.sh"

command_name=${HPC_MAKE_COMMAND:-}
argument_count=${HPC_MAKE_ARGUMENT_COUNT:-0}
argument_1=${HPC_MAKE_ARGUMENT_1:-}
performance_target=${HPC_MAKE_TARGET:-m1}

if test "${HPC_MAKE_TARGET_ORIGIN:-file}" = file; then
    performance_target=m1
fi

expect_arguments() {
    test "$argument_count" = "$1" || die "$2"
}

case $command_name in
    bench)
        expect_arguments 1 "usage: make bench <action>"
        set --
        if test -n "${HPC_MAKE_ARGS:-}"; then
            bench_args=()
            read -r -a bench_args <<<"$HPC_MAKE_ARGS"
            set -- "${bench_args[@]}"
        fi
        exec "$SCRIPT_DIR/bench" "$argument_1" \
            --preset "${HPC_MAKE_PRESET:-profile}" \
            --target "$performance_target" \
            --threads "${HPC_MAKE_THREADS:-1}" \
            --ranks "${HPC_MAKE_RANKS:-1}" \
            "$@"
        ;;
    pgo)
        expect_arguments 1 "usage: make pgo <gen|use>"
        case $argument_1 in
            gen) action=pgo-generate ;;
            use) action=pgo-use ;;
            *) die "usage: make pgo <gen|use>" ;;
        esac
        export HPC_PGO_DISPATCH=1
        exec "$SCRIPT_DIR/bench" "$action" \
            --target "$performance_target"
        ;;
    check)
        test "$argument_count" -le 1 ||
            die "usage: make check [lint|analyze|test|all]"
        exec "$SCRIPT_DIR/check" "${argument_1:-all}" \
            --preset "${HPC_MAKE_PRESET:-mac-check}"
        ;;
    cov)
        test "$argument_count" -le 1 ||
            die "usage: make cov [llvm|gcov|clean|report]"
        action=${argument_1:-llvm}
        case ${HPC_MAKE_PRESET_ORIGIN:-file} in
            command\ line | environment | override)
                exec "$SCRIPT_DIR/coverage" "$action" \
                    --preset "${HPC_MAKE_PRESET:-}"
                ;;
            *) exec "$SCRIPT_DIR/coverage" "$action" ;;
        esac
        ;;
    explore | profile)
        test "$argument_count" -le 1 || die "usage: make $command_name [action]"
        if test "$command_name" = explore; then
            action=${argument_1:-all}
        else
            action=${argument_1:-perf-stat}
        fi
        preset=profile
        case ${HPC_MAKE_PRESET_ORIGIN:-file} in
            command\ line | environment | override)
                preset=${HPC_MAKE_PRESET:-profile}
                ;;
        esac
        exec "$SCRIPT_DIR/$command_name" "$action" \
            --preset "$preset" --target "${HPC_MAKE_TARGET:-m0}"
        ;;
    hpc)
        test "$argument_count" -le 1 || die "usage: make hpc [command]"
        exec "$SCRIPT_DIR/hpc" "${argument_1:-doctor}" \
            --cluster "${HPC_MAKE_CLUSTER:-rangpur}"
        ;;
    package)
        test "$argument_count" -le 1 || die "usage: make package [a1|m1]"
        exec "$SCRIPT_DIR/package" "${argument_1:-a1}"
        ;;
    clean)
        case $argument_count:$argument_1 in
            0:)
                safe_clean "${HPC_MAKE_PRESET:-mac-check}"
                ;;
            1:all) safe_clean all ;;
            *) die "usage: make clean [all]" ;;
        esac
        ;;
    fmt)
        case $argument_count:$argument_1 in
            0:) exec "$SCRIPT_DIR/fmt" ;;
            1:fix | 1:--fix) exec "$SCRIPT_DIR/fmt" --fix ;;
            *) die "usage: make fmt [fix]" ;;
        esac
        ;;
    san)
        expect_arguments 1 "usage: make san <au|t|m>"
        exec "$SCRIPT_DIR/san" "$argument_1"
        ;;
    *) die "unknown positional Make command: $command_name" ;;
esac
