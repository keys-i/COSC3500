#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=tools/scripts/tools/lib.sh
. "$SCRIPT_DIR/lib.sh"

tool_config_validate
clang_config_validate

fix=false
case ${1:-} in
    '') ;;
    fix | --fix) fix=true ;;
    --help)
        printf 'usage: %s [--fix]\n' "${0##*/}"
        exit 0
        ;;
    *) die "unknown fmt action: $1" ;;
esac
(($# <= 1)) || die "fmt accepts only fix"

formatter=
if formatter=$(find_llvm_tool clang-format); then
    source_files=()
    while IFS= read -r file; do
        source_files+=("$file")
    done < <(list_source_files)
    if ((${#source_files[@]} > 0)); then
        style="{BasedOnStyle: "
        style+="$(clang_config_get format based_on_style), "
        style+="IndentWidth: $(clang_config_get format indent_width), "
        style+="ColumnLimit: $(clang_config_get format column_limit), "
        style+="SortIncludes: $(clang_config_get format sort_includes)}"
        options=(--style="$style")
        if test "$fix" = true; then
            options+=(-i)
        else
            options+=(--dry-run --Werror)
        fi
        run "$formatter" "${options[@]}" "${source_files[@]}"
        pass "format"
    else
        skip "no owned C/C++ sources"
    fi
else
    skip "clang-format unavailable"
fi

limit=$(clang_config_get format column_limit)
validate_positive_integer "$limit" column_limit
failed=false
while IFS= read -r -d '' file; do
    test -f "$HPC_ROOT/$file" || continue
    test "$file" = uv.lock && continue
    grep -Iq . "$HPC_ROOT/$file" || continue
    if ! awk -v limit="$limit" '
        length($0) > limit {
            printf "%s:%d:%d\n", FILENAME, FNR, length($0)
            failed = 1
        }
        END { exit failed }
    ' "$HPC_ROOT/$file"; then
        failed=true
    fi
done < <(
    git -C "$HPC_ROOT" ls-files \
        --cached --others --exclude-standard -z
)
test "$failed" = false || die "lines exceed $limit columns"
pass "line length"
