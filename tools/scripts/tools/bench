#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=tools/scripts/tools/lib.sh
. "$SCRIPT_DIR/lib.sh"

CONFIG="$HPC_ROOT/tools/config/benchmark.yml"
BENCHMARK_KEYS=smoke.warmups,smoke.samples,smoke.process_runs
BENCHMARK_KEYS+=,smoke.minimum_case_ms
BENCHMARK_KEYS+=,standard.warmups,standard.samples,standard.process_runs
BENCHMARK_KEYS+=,standard.minimum_case_ms
BENCHMARK_KEYS+=,publication.warmups,publication.samples
BENCHMARK_KEYS+=,publication.process_runs,publication.minimum_case_ms
BENCHMARK_KEYS+=,control.bootstrap_resamples,control.raw_dir
BENCHMARK_KEYS+=,control.summary_dir,control.cluster_presets
BENCHMARK_KEYS+=,control.blocked_modes,control.pgo_dir
config_validate_nested "$CONFIG" "$BENCHMARK_KEYS"

case ${1:-} in
    --help | help)
        printf 'usage: %s ' "${0##*/}"
        printf '%s\n' \
            'self-test|gates|smoke|standard|publication|compare|bolt' \
            '[--case <name>]'
        exit 0
        ;;
esac

action=${1:-smoke}
(($# == 0)) || shift
preset=profile
target=m1
threads=1
ranks=1
final_run=false
case_selector=all
while (($# > 0)); do
    case $1 in
        --preset)
            (($# >= 2)) || die "--preset requires a value"
            preset=$2
            shift 2
            ;;
        --target)
            (($# >= 2)) || die "--target requires a value"
            target=$2
            shift 2
            ;;
        --threads)
            (($# >= 2)) || die "--threads requires a value"
            threads=$2
            shift 2
            ;;
        --ranks)
            (($# >= 2)) || die "--ranks requires a value"
            ranks=$2
            shift 2
            ;;
        --case)
            (($# >= 2)) || die "--case requires a value"
            case_selector=$2
            shift 2
            ;;
        --final)
            final_run=true
            shift
            ;;
        *) die "unknown benchmark option: $1" ;;
    esac
done
benchmark_actions=self-test,gates,smoke,standard,publication,compare,bolt
benchmark_actions+=,pgo-generate,pgo-use
validate_choice "$action" "$benchmark_actions" "benchmark action"
validate_positive_integer "$threads" threads
validate_positive_integer "$ranks" ranks
if test "$target" = m1 &&
    { test "$threads" != 1 || test "$ranks" != 1; }; then
    die "m1 benchmarks require threads=1 and ranks=1"
fi

case $action in
    standard | publication)
        case $case_selector in
            all | continuous-large | continuous-million) ;;
            *)
                die "$action only times continuous-large or continuous-million"
                ;;
        esac
        ;;
esac

case $action in
    pgo-generate | pgo-use)
        test "${HPC_PGO_DISPATCH:-0}" = 1 || die "use pgo gen or pgo use"
        ;;
esac

require_pgo_continuous() {
    test "$target" = m1 || die "PGO training is only defined for m1"
    test "$case_selector" = all || test "$case_selector" = continuous ||
        die "PGO training uses the continuous benchmark case"
}

run_pgo_generate() {
    require_target "$target"
    require_pgo_continuous
    local -a argument=(templates/predator-prey-large)
    local pgo_dir
    pgo_dir="$HPC_ROOT/$(config_get_nested "$CONFIG" control pgo_dir)"
    test "$pgo_dir" = "$HPC_ROOT/build/pgo-generate/pgo" ||
        die "unsafe PGO directory: $pgo_dir"
    if test -e "$pgo_dir"; then
        [[ -d "$pgo_dir" && ! -L "$pgo_dir" ]] ||
            die "unsafe PGO directory: $pgo_dir"
        run cmake -E remove_directory "$pgo_dir"
    fi
    configure_preset pgo-generate --fresh
    build_preset pgo-generate --target "$target"
    local binary="$HPC_ROOT/build/pgo-generate/bin/$target"
    cd "$HPC_ROOT"
    for _ in 1 2 3 4 5; do
        run "$binary" "${argument[@]}"
    done
    local compiler_id
    compiler_id=$(compiler_field pgo-generate CMAKE_CXX_COMPILER_ID)
    if [[ $compiler_id == *Clang* ]]; then
        local profdata
        if ! profdata=$(find_llvm_tool llvm-profdata); then
            die "llvm-profdata is required to merge Clang PGO data"
        fi
        local profile_files=()
        while IFS= read -r file; do
            profile_files+=("$file")
        done < <(find "$pgo_dir" -name '*.profraw' -type f -print)
        ((${#profile_files[@]} > 0)) ||
            die "Clang training produced no .profraw files"
        run "$profdata" merge \
            -output="$pgo_dir/default.profdata" \
            "${profile_files[@]}"
    fi
    pass "PGO training data generated"
}

run_pgo_use() {
    require_target "$target"
    require_pgo_continuous
    configure_preset pgo-use --fresh
    build_preset pgo-use --target "$target" hpc_bench
    run ctest --test-dir "$HPC_ROOT/build/pgo-use" --output-on-failure \
        -R "^${target}\\.|^hpc\\.benchmark\\.selftest$"
    pass "PGO-use build and correctness smoke"
}

expect_rejection() {
    local name=$1
    local expected=$2
    shift 2
    local log="$HPC_BUILD_ROOT/benchmark-gates/$name.txt"
    run mkdir -p "${log%/*}"
    print_command "$@"
    if "$@" >"$log" 2>&1; then
        die "bench guard should reject: $name"
    fi
    grep -Fq "$expected" "$log" ||
        die "bench guard missed: $name"
    pass "bench guard: $name"
}

run_gate_tests() {
    configure_preset asan-ubsan --fresh
    expect_rejection profile-mode "unknown cluster preset: profile" \
        "$SCRIPT_DIR/bench" smoke --preset profile --target m1 --final
    expect_rejection sanitizer "won't time a sanitizer build" \
        "$SCRIPT_DIR/bench" smoke --preset asan-ubsan --target m1
    expect_rejection standard-scope \
        "standard only times continuous-large or continuous-million" \
        "$SCRIPT_DIR/bench" standard --case cellular
    expect_rejection serial-metadata \
        "m1 benchmarks require threads=1 and ranks=1" \
        "$SCRIPT_DIR/bench" smoke --threads 2
}

case $action in
    self-test)
        ensure_built "$preset" hpc_bench
        run "$(build_dir "$preset")/bench/hpc_bench" --self-test
        exit 0
        ;;
    gates)
        run_gate_tests
        exit 0
        ;;
    pgo-generate)
        run_pgo_generate
        exit 0
        ;;
    pgo-use)
        run_pgo_use
        exit 0
        ;;
    bolt)
        skip "BOLT: no target is ready for BOLT"
        exit 0
        ;;
    compare)
        skip "compare: nothing to compare yet"
        exit 0
        ;;
esac

require_preset "$preset"
require_target "$target"
test "$target" = m1 || die "only m1 has a benchmark adapter"
if test "$final_run" = true; then
    cluster_presets=$(config_get_nested "$CONFIG" control cluster_presets)
    validate_choice "$preset" "$cluster_presets" "cluster preset"
fi
ensure_configured "$preset"

mode=$(cache_value "$preset" HPC_MODE)
sanitizer=$(cache_value "$preset" HPC_SANITIZER)
coverage=$(cache_value "$preset" HPC_COVERAGE)
test "$sanitizer" = none || die "won't time a sanitizer build"
test "$coverage" = none || die "won't time a coverage build"

if test "$final_run" = true; then
    blocked_modes=$(config_get_nested "$CONFIG" control blocked_modes)
    case ",$blocked_modes," in
        *",$mode,"*)
            die "build mode $mode isn't for final timing"
            ;;
    esac
    git_is_dirty && die "final timing needs a clean worktree"
    test -n "${SLURM_JOB_ID:-}" ||
        die "final timing needs a Slurm allocation"
    marker="$(build_dir "$preset")/configured-host.txt"
    grep -Fxq "slurm_job_id=$SLURM_JOB_ID" "$marker" ||
        die "build was not configured in this allocation"
fi
build_preset "$preset" --target "$target" hpc_bench

warmups=$(config_get_nested "$CONFIG" "$action" warmups)
samples=$(config_get_nested "$CONFIG" "$action" samples)
process_runs=$(config_get_nested "$CONFIG" "$action" process_runs)
minimum_case_ms=$(config_get_nested "$CONFIG" "$action" minimum_case_ms)
bootstrap_resamples=$(
    config_get_nested "$CONFIG" control bootstrap_resamples
)
validate_positive_integer "$warmups" warmups
validate_positive_integer "$samples" samples
validate_positive_integer "$process_runs" process_runs
validate_positive_integer "$minimum_case_ms" minimum_case_ms
validate_positive_integer "$bootstrap_resamples" bootstrap_resamples

raw_dir="$HPC_ROOT/$(config_get_nested "$CONFIG" control raw_dir)"
summary_dir="$HPC_ROOT/$(config_get_nested "$CONFIG" control summary_dir)"
run mkdir -p "$raw_dir" "$summary_dir"
timestamp=$(date -u +%Y%m%dT%H%M%SZ)
run_id="$timestamp-$$"
binary=$(target_binary "$preset" "$target")
helper="$(build_dir "$preset")/bench/hpc_bench"
compiler=$(cache_value "$preset" CMAKE_CXX_COMPILER)
compiler_id=$(compiler_field "$preset" CMAKE_CXX_COMPILER_ID)
compiler_version=$(compiler_field "$preset" CMAKE_CXX_COMPILER_VERSION)
commit=$(git_commit)
binary_hash=$(sha256_file "$binary")
host=$(hostname -s)
cpu=$(cpu_name)
flags="mode=$mode;sanitizer=$sanitizer;coverage=$coverage;"
flags+="lto=$(cache_value "$preset" HPC_ENABLE_LTO)"
compile_commands=$(
    ninja -C "$(build_dir "$preset")" -t commands "$target" |
        tr '\n' ';'
)
test -n "$compile_commands" || die "Ninja returned no commands for $target"
flags+=";commands=$compile_commands"

cd "$HPC_ROOT"
print_command "$helper" --cases "$target"
case_rows=$("$helper" --cases "$target") || die "cannot list benchmark cases"
selected_cases=()
while IFS='|' read -r case_name backend work_unit input_size seed; do
    [[ -n "$case_name" && -n "$backend" && -n "$work_unit" ]] ||
        die "invalid benchmark case metadata"
    case $case_name in
        *[!a-z0-9-]* | '') die "invalid benchmark case name: $case_name" ;;
    esac
    if test "$action" != smoke && test "$case_name" != continuous-large &&
        test "$case_name" != continuous-million; then
        continue
    fi
    if test "$case_selector" = all || test "$case_selector" = "$case_name"; then
        selected_cases+=("$case_name|$backend|$input_size|$seed|$work_unit")
    fi
done <<<"$case_rows"
((${#selected_cases[@]} > 0)) || die "unknown benchmark case: $case_selector"

for selected in "${selected_cases[@]}"; do
    IFS='|' read -r case_name backend input_size seed work_unit <<<"$selected"
    raw="$raw_dir/$target-$case_name-$preset-$run_id.csv"
    summary="$summary_dir/$target-$case_name-$preset-$run_id.csv"
    run "$helper" \
        --binary "$binary" \
        --target "$target" \
        --case "$case_name" \
        --preset "$preset" \
        --compiler "$compiler_id:$compiler" \
        --compiler-version "$compiler_version" \
        --flags "$flags" \
        --git-commit "$commit" \
        --binary-sha256 "$binary_hash" \
        --host "$host" \
        --cpu "$cpu" \
        --backend "$backend" \
        --timestamp "$timestamp" \
        --mode end-to-end \
        --size "$input_size" \
        --seed "$seed" \
        --threads "$threads" \
        --ranks "$ranks" \
        --warmup "$warmups" \
        --samples "$samples" \
        --process-run "$process_runs" \
        --minimum-case-ms "$minimum_case_ms" \
        --bootstrap-resamples "$bootstrap_resamples" \
        --verify \
        --output "${raw##*/}" \
        --summary "${summary##*/}"
    run "$helper" --validate-csv "${raw##*/}" "${summary##*/}"
    pass "$action $target $case_name benchmark ($work_unit)"
done
